# Caerus API Key (generada desde el dashboard)
CAERUS_API_KEY=caer_dev_tu_api_key_aqui

# Endpoint gRPC del motor Caerus (opcional, por defecto el del SDK: caerus.dev.ar.sdk.apps.disilab.ar:443)
# CAERUS_ENDPOINT=

# TLS habilitado (false solo para desarrollo local contra localhost)
CAERUS_TLS=true

# Namespace de Distributed Locks para la demo
DLS_NAMESPACE=task_processing
