# Caerus API Key (generada desde el dashboard)
CAERUS_API_KEY=caer_dev_tu_api_key_aqui

# Endpoint gRPC del motor Caerus (opcional; por defecto localhost:9090 o la URL de tu clúster de Caerus)
# CAERUS_ENDPOINT=localhost:9090

# TLS habilitado (false para desarrollo local contra localhost)
CAERUS_TLS=false

# Namespace de Distributed Locks para la demo
DLS_NAMESPACE=task_processing
